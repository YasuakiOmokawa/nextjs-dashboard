{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["web/src/main.tsx"],
  "ignoreDependencies": ["pg", "@effect/tsgo"],
  "ignorePatterns": ["vendor/**"],
  "boundaries": {
    "zones": [
      {
        "name": "contract",
        "patterns": ["src/spa-contract.ts", "db/ids.ts", "db/column-values.ts"]
      },
      {
        "name": "server",
        "patterns": ["src/**", "db/**"]
      },
      {
        "name": "spa",
        "patterns": ["web/src/**"]
      }
    ],
    "rules": [
      {
        "from": "spa",
        "allow": ["contract"],
        "allowTypeOnly": []
      },
      {
        "from": "contract",
        "allow": ["contract"],
        "allowTypeOnly": ["server"]
      }
    ]
  }
}
