{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/build/**",
      "!**/coverage/**",
      "!**/*.generated.*",
      "!drizzle/migrations/**",
      "!e2e/playwright-report/**",
      "!e2e/test-results/**",
      "!vendor/**"
    ]
  },
  "plugins": [
    {
      "path": "./biome-plugins/no-raw-request-input.grit",
      "includes": ["**/src/**/*.ts", "!**/web/**", "!**/__tests__/**"]
    },
    {
      "path": "./biome-plugins/no-direct-json.grit",
      "includes": [
        "**/src/**/*.ts",
        "!**/web/**",
        "!**/src/run-json.ts",
        "!**/__tests__/**"
      ]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": { "enabled": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "complexity": { "noUselessTypeConstraint": "error" },
      "correctness": {
        "noUnusedVariables": {
          "level": "warn",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noNamespace": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/drizzle/pool", "./pool"],
                "message": "db/drizzle/pool は Worker の入口と db/drizzle/client.ts だけが使う (db/CLAUDE.md)"
              },
              {
                "group": ["effect/http"],
                "message": "handler は契約が decode した値を受け、成功の値を返す。HttpServerRequest・HttpServerResponse (effect/http) を使えるのは、契約を Hono に載せる file だけ (ADR-0007)"
              },
              {
                "group": ["@sentry/*"],
                "message": "Sentry の SDK は Worker の入口 (src/worker.ts) だけが使う。報告は src/lib/report-error.ts の reportError (src/lib/CLAUDE.md)"
              }
            ]
          }
        },
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noUnsafeDeclarationMerging": "error",
        "noUnusedExpressions": "off",
        "useNamespaceKeyword": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "e2e/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["*.ts", "*.tsx", "*.mts", "*.cts"],
      "linter": {
        "rules": {
          "complexity": { "noArguments": "error" },
          "correctness": {
            "noConstAssign": "off",
            "noGlobalObjectCalls": "off",
            "noInvalidBuiltinInstantiation": "off",
            "noInvalidConstructorSuper": "off",
            "noSetterReturn": "off",
            "noUndeclaredVariables": "off",
            "noUnreachable": "off",
            "noUnreachableSuper": "off"
          },
          "style": { "useConst": "error" },
          "suspicious": {
            "noClassAssign": "off",
            "noDuplicateClassMembers": "off",
            "noDuplicateObjectKeys": "off",
            "noDuplicateParameters": "off",
            "noFunctionAssign": "off",
            "noImportAssign": "off",
            "noRedeclare": "off",
            "noUnsafeNegation": "off",
            "noVar": "error",
            "noWith": "off",
            "useGetterReturn": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
