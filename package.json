{
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "vite build --config web/vite.config.ts && bun --conditions=browser web/prerender.tsx",
    "dev": "vite --config web/vite.config.ts",
    "start": "bash scripts/wrangler-dev.sh",
    "test": "vitest",
    "test:db": "docker compose up -d test_db --wait && vitest run; EXIT_CODE=$?; docker compose stop test_db; exit $EXIT_CODE",
    "qa:serve": "bash scripts/qa-serve.sh serve",
    "qa:login": "bash scripts/qa-serve.sh login",
    "qa:down": "bash scripts/qa-serve.sh down",
    "dev:login": "bash scripts/qa-serve.sh dev-login",
    "lint": "biome check . && fallow audit",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bash scripts/typecheck.sh",
    "audit:high": "bun audit --audit-level=high --ignore=GHSA-vfj7-8cjw-p6xm --ignore=GHSA-68fv-2mgg-jv7q"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@effect/atom-react": "4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/lusitana": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/cloudflare": "^10.76.0",
    "@taimei-code/auth-client": "3.6.0",
    "@tanstack/react-router": "^1.170.41",
    "autoprefixer": "10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0",
    "hono": "^4.13.12",
    "lucide-react": "^1.46.0",
    "pg": "^8.23.0",
    "postcss": "8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "scheduler": "0.28.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/tsgo": "0.48.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "fallow": "^3.25.0",
    "playwright": "^1.63.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "7.0.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.1",
    "wrangler": "4.147.0"
  },
  "trustedDependencies": [],
  "overrides": {
    "undici": "^7.29.0",
    "rollup": "^4.59.0",
    "ws": "^8.21.0",
    "vite": "^6.4.4",
    "nanoid": "^3.3.18",
    "postcss": "8.5.28",
    "sharp": "^0.35.0"
  }
