{
  "name": "taimei-poc-do",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "COMPANY", "class_name": "Company" },
      { "name": "TRIAL", "class_name": "Trial" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Company", "Trial"] }]
}
