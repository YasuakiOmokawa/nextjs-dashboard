{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "esnext", "ES2023"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["vitest/globals"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          // HttpApi と Atom は unstable と承知で採用した (docs/adr/0007-spa-api-contract-and-effect-atom.md)
          "unstableApiUsage": "off"
        },
        "overrides": [
          {
            // @ts-expect-error で型エラーを確かめる行に、tsc の型エラーと重ねて出る
            "include": ["**/*.test.ts"],
            "options": {
              "diagnosticSeverity": {
                "missingEffectContext": "off",
                "missingEffectError": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "e2e", "vendor", "web"]
}
