{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "esnext", "ES2023"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["vitest/globals"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // unstable と承知で採用した module (docs/adr/0007-spa-api-contract-and-effect-atom.md)
        "allowedUnstableApis": [
          "effect/http-api",
          "effect/http",
          "effect/reactivity",
          "@effect/atom-react"
        ],
        "overrides": [
          {
            "include": ["**/__tests__/**/*.ts"],
            "options": {
              "allowedUnstableApis": [
                "effect/http-api",
                "effect/http",
                "effect/reactivity",
                "@effect/atom-react",
                "effect/Arbitrary"
              ]
            }
          },
          {
            // @ts-expect-error で型エラーを確かめる行に、tsc の型エラーと重ねて出る
            "include": ["**/*.test.ts"],
            "options": {
              "diagnosticSeverity": {
                "missingEffectContext": "off",
                "missingEffectError": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "e2e", "vendor", "web"]
}
